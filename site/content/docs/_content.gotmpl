{{- $weights := dict "installation" 100 "usage" 200 "tui" 300 "development" 400 }}
{{- $icons := dict "installation" "download" "usage" "terminal" "tui" "dashboard" "development" "code" }}
{{- range resources.Match "narf-docs/*.md" }}
  {{- $name := path.BaseName .Name }}
  {{- $source := .Content }}
  {{- $title := index (findRESubmatch `(?m)^# (.+)$` $source 1) 0 1 }}
  {{- $body := replaceRE `(?m)\A# .+\n+` "" $source 1 }}
  {{- $.AddPage (dict
    "path" $name
    "title" $title
    "weight" (index $weights $name | default 900)
    "params" (dict "icon" (index $icons $name | default "article"))
    "content" (dict "mediaType" "text/markdown" "value" $body)
  ) }}
{{- end }}
